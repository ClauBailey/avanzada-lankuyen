// ============================================================
// Avanzada Lankuyen — esquema de datos
// PostgreSQL 17 · Prisma ORM 7
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum Role {
  AA
  PP
  COORDINADOR
}

enum CommunityInternalRole {
  COORDINADOR
  SECRETARIO
  TESORERO
  ADMINISTRADOR
}

enum AdultTeamRole {
  RESPONSABLE_AVANZADA
  ASISTENTE_AVANZADA
}

enum BadgeCategory {
  ETAPA
  COMPETENCIA
  PROMESA
}

enum AchievementVisibility {
  PUBLIC
  HINT
  SECRET
}

enum AchievementCategory {
  AVANZADA
  COMUNIDAD
  ESPECIAL
  SECRETO
}

enum StageCode {
  SENDERO
  CUMBRE
}

/**
 * Los cinco momentos simbólicos del camino, sin orden obligatorio ni bloqueos.
 * La Promesa puede vivir con independencia de la etapa en que esté la persona.
 */
enum SymbolicMoment {
  BIENVENIDA_INVESTIDURA
  SENDERO
  CUMBRE
  PROMESA
  PASO_AL_CLAN
}

/**
 * Fórmulas de la Promesa que la persona puede elegir libremente (Manual p. 49).
 */
enum PromiseFormula {
  LEY_GUIA
  LEY_SCOUT
  LEY
}

enum PromiseStatus {
  PREPARACION
  SOLICITADA
  CELEBRADA
}

/**
 * Las siete áreas oficiales de competencias (Manual p. 278–279).
 */
enum CompetencyArea {
  CULTURA
  TRABAJO_EN_EQUIPO
  INNOVACION
  COMUNICACION
  CIUDADANIA
  MEDIOAMBIENTE
  VIDA_AIRE_LIBRE_Y_DEPORTES
}

/**
 * Evaluación cualitativa posterior a una actividad: observación, no nota.
 */
enum ObjectiveAchievementLevel {
  LOGRADO_PLENAMENTE
  LOGRADO_PARCIALMENTE
  NO_LOGRADO_REPLANTEAR
}

enum DevelopmentArea {
  CORPORALIDAD
  CREATIVIDAD
  CARACTER
  AFECTIVIDAD
  SOCIABILIDAD
  ESPIRITUALIDAD
}

/**
 * Autoevaluación del joven en su Brújula. No hay aprobación adulta:
 * solo el paso de «en exploración / en camino» a «logrado en mi vida cotidiana».
 */
enum CompassObjectiveStatus {
  EXPLORANDO
  LOGRADO_EN_VIDA_COTIDIANA
}

enum ActivityType {
  REUNION
  SALIDA
  FORMACION
  SERVICIO
  CELEBRACION
  OTRO
}

enum RsvpStatus {
  CONFIRMADO
  NO_ASISTE
}

enum AttendanceStatus {
  PRESENTE
  AUSENTE
  JUSTIFICADO
}

enum RouteSheetStatus {
  PENDIENTE_AUTORIZACION
  APROBADA
  RECHAZADA
}

enum NotificationType {
  RSVP_CONFIRMADO
  INASISTENCIA_JUSTIFICADA
  HOJA_ENVIADA
  HOJA_APROBADA
  HOJA_RECHAZADA
  RECORDATORIO_HOJA_FALTANTE
  INSIGNIA_OTORGADA
  CUENTA_CREADA
  PASSWORD_RESETEADA
  BITACORA_ENVIADA
  BITACORA_APROBADA
  BITACORA_RECHAZADA
  LOGRO_DESBLOQUEADO
  PROMESA_SOLICITADA
  COMPETENCIA_RECONOCIDA
  CONSENSO_SOLICITADO
}

enum LogbookEntryStatus {
  PENDIENTE_APROBACION
  PUBLICADA
  RECHAZADA
}

enum Channel {
  IN_APP
  EMAIL
}

enum DeliveryStatus {
  PENDIENTE
  ENVIADO
  FALLIDO
}

enum JobStatus {
  RUNNING
  OK
  ERROR
}

// ------------------------------------------------------------
// Comunidades y usuarios
// ------------------------------------------------------------

model Community {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(80)
  slug        String    @unique @db.VarChar(80)
  motto       String?   @db.VarChar(300)
  description String?   @db.Text
  color       String?   @db.VarChar(20)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  users       User[]
  roleHistory CommunityRoleHistory[]
  logEntries  CommunityLogEntry[]

  @@map("communities")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique @db.VarChar(40)
  email              String?   @unique @db.VarChar(255)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  firstName          String    @map("first_name") @db.VarChar(80)
  lastName           String    @map("last_name") @db.VarChar(80)
  preferredName      String?   @map("preferred_name") @db.VarChar(80)
  role               Role      @default(PP)
  communityId        String?   @map("community_id") @db.Uuid
  communityRole      CommunityInternalRole? @map("community_role")
  adultTeamRole      AdultTeamRole? @map("adult_team_role")
  phone              String?   @db.VarChar(30)
  birthDate          DateTime? @map("birth_date") @db.Date
  assignedAaId       String?   @map("assigned_aa_id") @db.Uuid
  assignedSince      DateTime? @map("assigned_since") @db.Timestamptz(3)
  avatarFileId       String?   @unique @map("avatar_file_id") @db.Uuid
  isActive           Boolean   @default(true) @map("is_active")
  isLogbookKeeper    Boolean   @default(false) @map("is_logbook_keeper")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdById        String?   @map("created_by_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  community       Community? @relation(fields: [communityId], references: [id], onDelete: Restrict)
  avatarFile      File?      @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  createdBy       User?      @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers    User[]     @relation("UserCreatedBy")
  assignedAa      User?      @relation("UserAssignedAa", fields: [assignedAaId], references: [id], onDelete: SetNull)
  assignedYouth   User[]     @relation("UserAssignedAa")
  communityRoles  CommunityRoleHistory[]

  badges              UserBadge[]         @relation("UserBadgeUser")
  grantedBadges       UserBadge[]         @relation("UserBadgeGrantedBy")
  revokedBadges       UserBadge[]         @relation("UserBadgeRevokedBy")
  reflections         StageReflection[]
  journeyMilestones   JourneyMilestone[]  @relation("JourneyMilestoneUser")
  accompaniedMilestones JourneyMilestone[] @relation("JourneyMilestoneAccompaniedBy")
  registeredMilestones  JourneyMilestone[] @relation("JourneyMilestoneRegisteredBy")
  promise             UserPromise?        @relation("UserPromiseUser")
  accompaniedPromises UserPromise[]       @relation("UserPromiseAccompaniedBy")
  registeredPromises  UserPromise[]       @relation("UserPromiseRegisteredBy")
  createdActivities   Activity[]          @relation("ActivityCreatedBy")
  ledActivities       ActivityLeader[]    @relation("ActivityLeaderUser")
  assignedLeaderShips ActivityLeader[]    @relation("ActivityLeaderAssignedBy")
  attendanceResponses AttendanceResponse[]
  attendanceRecords   AttendanceRecord[]  @relation("AttendanceRecordUser")
  ratifiedRecords     AttendanceRecord[]  @relation("AttendanceRecordRatifiedBy")
  activityEvaluations ActivityEvaluation[] @relation("ActivityEvaluationUser")
  uploadedRouteSheets RouteSheet[]        @relation("RouteSheetUploadedBy")
  reviewedRouteSheets RouteSheet[]        @relation("RouteSheetReviewedBy")
  uploadedFiles       File[]              @relation("FileUploadedBy")
  notifications       Notification[]
  logbookEntries      LogbookEntry[]      @relation("LogbookEntryAuthor")
  reviewedLogbookEntries LogbookEntry[]   @relation("LogbookEntryReviewedBy")
  updatedResources    UnitResource[]      @relation("UnitResourceUpdatedBy")
  settingsUpdated     AppSetting[]        @relation("AppSettingUpdatedBy")
  auditLogs           AuditLog[]
  achievements        UserAchievement[]   @relation("UserAchievements")
  awardedAchievements UserAchievement[]   @relation("AwardedAchievements")
  compassObjectives   UserCompassObjective[] @relation("UserCompassObjectiveUser")
  compassReflections  UserCompassReflection[] @relation("UserCompassReflectionUser")
  mentoringNotesReceived MentoringNote[]   @relation("MentoringNoteStudent")
  mentoringNotesWritten  MentoringNote[]   @relation("MentoringNoteAuthor")
  communityLogEntries CommunityLogEntry[]  @relation("CommunityLogEntryAuthor")

  @@index([communityId])
  @@index([role])
  @@index([isActive])
  @@index([assignedAaId])
  @@map("users")
}

/**
 * Historial de cargos internos de una comunidad juvenil.
 *
 * Cada rotación cierra el registro vigente (`endedAt`) y abre uno nuevo, de
 * modo que se conserva la trazabilidad de quién coordinó, secretarió, etc.
 */
model CommunityRoleHistory {
  id          String                @id @default(uuid()) @db.Uuid
  communityId String                @map("community_id") @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  role        CommunityInternalRole
  assignedAt  DateTime              @default(now()) @map("assigned_at") @db.Timestamptz(3)
  endedAt     DateTime?             @map("ended_at") @db.Timestamptz(3)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([communityId, endedAt])
  @@index([userId])
  @@map("community_role_history")
}

// ------------------------------------------------------------
// Progresión personal
// ------------------------------------------------------------

model Badge {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique @db.VarChar(50)
  category    BadgeCategory
  stageCode   StageCode?    @map("stage_code")
  competencyArea CompetencyArea? @map("competency_area")
  name        String        @db.VarChar(100)
  description String        @db.Text
  imagePath   String        @map("image_path") @db.VarChar(255)
  sortOrder   Int           @default(0) @map("sort_order")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  grants UserBadge[]

  @@index([category, sortOrder])
  @@map("badges")
}

model UserBadge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  badgeId     String    @map("badge_id") @db.Uuid
  grantedById String?   @map("granted_by_id") @db.Uuid
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  note        String?   @db.Text
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById String?   @map("revoked_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User  @relation("UserBadgeUser", fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge @relation(fields: [badgeId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("UserBadgeGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy User? @relation("UserBadgeRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, badgeId])
  @@index([badgeId])
  @@map("user_badges")
}

model StageReflection {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  stageCode StageCode @map("stage_code")
  content   String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stageCode])
  @@map("stage_reflections")
}

/**
 * Momentos del camino simbólico registrados por la persona o su AA.
 *
 * No hay orden obligatorio: el paso al Clan, la investidura, el inicio de una
 * etapa o un nuevo paso por SENDERO se guardan como memoria, nunca como
 * condición para acceder a otra cosa.
 */
model JourneyMilestone {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  moment          SymbolicMoment
  occurredAt      DateTime        @map("occurred_at") @db.Date
  place           String?         @db.VarChar(180)
  story           String?         @db.Text
  accompaniedBy   String?         @map("accompanied_by") @db.VarChar(180)
  accompaniedById String?         @map("accompanied_by_id") @db.Uuid
  registeredById  String?         @map("registered_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User  @relation("JourneyMilestoneUser", fields: [userId], references: [id], onDelete: Cascade)
  accompaniedByUser User? @relation("JourneyMilestoneAccompaniedBy", fields: [accompaniedById], references: [id], onDelete: SetNull)
  registeredBy      User? @relation("JourneyMilestoneRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)

  @@unique([userId, moment])
  @@index([userId])
  @@map("journey_milestones")
}

/**
 * Preparación y celebración de la Promesa.
 *
 * Se solicita y se registra con independencia de la etapa, la antigüedad o los
 * objetivos. La fórmula pertenece a la persona que la pronuncia.
 */
model UserPromise {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @unique @map("user_id") @db.Uuid
  formula          PromiseFormula?
  status           PromiseStatus  @default(PREPARACION)
  desiredPlace     String?        @map("desired_place") @db.VarChar(180)
  motivation       String?        @db.Text
  requestedAt      DateTime?      @map("requested_at") @db.Timestamptz(3)
  celebratedAt     DateTime?      @map("celebrated_at") @db.Date
  celebrationPlace String?        @map("celebration_place") @db.VarChar(180)
  story            String?        @db.Text
  accompaniedBy    String?        @map("accompanied_by") @db.VarChar(180)
  accompaniedById  String?        @map("accompanied_by_id") @db.Uuid
  registeredById   String?        @map("registered_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User  @relation("UserPromiseUser", fields: [userId], references: [id], onDelete: Cascade)
  accompaniedByUser User? @relation("UserPromiseAccompaniedBy", fields: [accompaniedById], references: [id], onDelete: SetNull)
  registeredBy      User? @relation("UserPromiseRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)

  @@map("user_promises")
}

// ------------------------------------------------------------
// Logros estilo RPG
// ------------------------------------------------------------

model Achievement {
  id          String                @id @default(uuid()) @db.Uuid
  code        String                @unique @db.VarChar(80)
  title       String                @db.VarChar(120)
  description String                @db.Text
  hint        String?               @db.Text
  icon        String                @db.VarChar(40)
  category    AchievementCategory   @default(AVANZADA)
  visibility  AchievementVisibility @default(PUBLIC)
  points      Int                   @default(10)
  isActive    Boolean               @default(true) @map("is_active")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  unlockedBy UserAchievement[]

  @@index([category, visibility])
  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  achievementId String   @map("achievement_id") @db.Uuid
  unlockedAt    DateTime @default(now()) @map("unlocked_at") @db.Timestamptz(3)
  awardedById   String?  @map("awarded_by_id") @db.Uuid
  note          String?  @db.Text

  user        User        @relation("UserAchievements", fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  awardedBy   User?       @relation("AwardedAchievements", fields: [awardedById], references: [id], onDelete: SetNull)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@map("user_achievements")
}

// ------------------------------------------------------------
// Calendario semestral
// ------------------------------------------------------------

model Semester {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(60)
  startsOn  DateTime @map("starts_on") @db.Date
  endsOn    DateTime @map("ends_on") @db.Date
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  activities Activity[]

  @@map("semesters")
}

model Activity {
  id          String       @id @default(uuid()) @db.Uuid
  semesterId  String       @map("semester_id") @db.Uuid
  title       String       @db.VarChar(160)
  description String?      @db.Text
  type        ActivityType @default(REUNION)
  startsAt    DateTime     @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime     @map("ends_at") @db.Timestamptz(3)
  location    String?      @db.VarChar(160)
  isPublished Boolean      @default(true) @map("is_published")
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(3)

  semester   Semester             @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  createdBy  User?                @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  leaders     ActivityLeader[]
  responses   AttendanceResponse[]
  records     AttendanceRecord[]
  routeSheets RouteSheet[]
  evaluations ActivityEvaluation[]
  logbookEntries LogbookEntry[]
  compassReflections UserCompassReflection[]

  @@index([semesterId, startsAt])
  @@index([startsAt])
  @@map("activities")
}

model ActivityLeader {
  activityId   String   @map("activity_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation("ActivityLeaderUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("ActivityLeaderAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([activityId, userId])
  @@index([userId])
  @@map("activity_leaders")
}

// ------------------------------------------------------------
// Asistencia en dos fases
// ------------------------------------------------------------

model AttendanceResponse {
  id                String     @id @default(uuid()) @db.Uuid
  activityId        String     @map("activity_id") @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  status            RsvpStatus
  justificationText String?    @map("justification_text") @db.Text
  respondedAt       DateTime   @default(now()) @map("responded_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  activity           Activity            @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  justificationFiles JustificationFile[]

  @@unique([activityId, userId])
  @@index([userId])
  @@map("attendance_responses")
}

model JustificationFile {
  id                   String   @id @default(uuid()) @db.Uuid
  attendanceResponseId String   @map("attendance_response_id") @db.Uuid
  fileId               String   @map("file_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  attendanceResponse AttendanceResponse @relation(fields: [attendanceResponseId], references: [id], onDelete: Cascade)
  file               File               @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([attendanceResponseId, fileId])
  @@map("justification_files")
}

model AttendanceRecord {
  id           String           @id @default(uuid()) @db.Uuid
  activityId   String           @map("activity_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  status       AttendanceStatus
  notes        String?          @db.Text
  ratifiedById String?          @map("ratified_by_id") @db.Uuid
  ratifiedAt   DateTime         @default(now()) @map("ratified_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation("AttendanceRecordUser", fields: [userId], references: [id], onDelete: Cascade)
  ratifiedBy User?    @relation("AttendanceRecordRatifiedBy", fields: [ratifiedById], references: [id], onDelete: SetNull)

  @@unique([activityId, userId])
  @@index([userId, status])
  @@map("attendance_records")
}

// ------------------------------------------------------------
// Evaluación posterior de actividades
// ------------------------------------------------------------

model ActivityEvaluation {
  id                        String                    @id @default(uuid()) @db.Uuid
  activityId                String                    @map("activity_id") @db.Uuid
  userId                    String                    @map("user_id") @db.Uuid
  objectiveAchievementLevel ObjectiveAchievementLevel @map("objective_achievement_level")
  experiencedAreas          DevelopmentArea[]         @map("experienced_areas")
  organizationFeedback      String?                   @map("organization_feedback") @db.Text
  emotionalResonance        String?                   @map("emotional_resonance") @db.Text
  learningsForNextTime      String?                   @map("learnings_for_next_time") @db.Text
  createdAt                 DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation("ActivityEvaluationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([userId])
  @@map("activity_evaluations")
}

// ------------------------------------------------------------
// Archivos y Hojas de Ruta
// ------------------------------------------------------------

model File {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String    @default("LOCAL") @db.VarChar(20)
  bucket         String?   @db.VarChar(120)
  objectKey      String    @unique @map("object_key") @db.VarChar(500)
  originalName   String    @map("original_name") @db.VarChar(255)
  mimeType       String    @map("mime_type") @db.VarChar(120)
  sizeBytes      Int       @map("size_bytes")
  checksumSha256 String?   @map("checksum_sha256") @db.VarChar(64)
  isPublic       Boolean   @default(false) @map("is_public")
  uploadedById   String?   @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  uploadedBy     User?               @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  avatarOf       User?               @relation("UserAvatar")
  justifications JustificationFile[]
  routeSheets    RouteSheet[]
  unitResources  UnitResource[]      @relation("UnitResourceImage")
  logbookEntries LogbookEntry[]      @relation("LogbookEntryPhoto")

  @@map("files")
}

model RouteSheet {
  id              String           @id @default(uuid()) @db.Uuid
  activityId      String           @map("activity_id") @db.Uuid
  uploadedById    String           @map("uploaded_by_id") @db.Uuid
  fileId          String           @map("file_id") @db.Uuid
  title           String?          @db.VarChar(160)
  description     String?          @db.Text
  status          RouteSheetStatus @default(PENDIENTE_AUTORIZACION)
  version         Int              @default(1)
  reviewedById    String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason String?          @map("rejection_reason") @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(3)

  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("RouteSheetUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  file       File     @relation(fields: [fileId], references: [id], onDelete: Restrict)
  reviewedBy User?    @relation("RouteSheetReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([activityId, version])
  @@index([activityId, status])
  @@map("route_sheets")
}

// ------------------------------------------------------------
// Notificaciones y automatización
// ------------------------------------------------------------

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(160)
  body        String           @db.Text
  entityType  String?          @map("entity_type") @db.VarChar(60)
  entityId    String?          @map("entity_id") @db.Uuid
  actionUrl   String?          @map("action_url") @db.VarChar(255)
  priority    Int              @default(0)
  dedupeKey   String?          @unique @map("dedupe_key") @db.VarChar(200)
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient  User                   @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([recipientId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationDelivery {
  id             String         @id @default(uuid()) @db.Uuid
  notificationId String         @map("notification_id") @db.Uuid
  channel        Channel
  status         DeliveryStatus @default(PENDIENTE)
  attempts       Int            @default(0)
  lastError      String?        @map("last_error") @db.Text
  sentAt         DateTime?      @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@map("notification_deliveries")
}

model JobRun {
  id         String    @id @default(uuid()) @db.Uuid
  jobName    String    @map("job_name") @db.VarChar(100)
  runKey     String    @map("run_key") @db.VarChar(100)
  status     JobStatus @default(RUNNING)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  stats      Json?
  error      String?   @db.Text

  @@unique([jobName, runKey])
  @@map("job_runs")
}

model AppSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation("AppSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("app_settings")
}

// ------------------------------------------------------------
// Material digital de la unidad
// ------------------------------------------------------------

model UnitResource {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(80)
  title       String   @db.VarChar(160)
  summary     String?  @db.VarChar(300)
  bodyMd      String   @map("body_md") @db.Text
  imageFileId String?  @map("image_file_id") @db.Uuid
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  imageFile File? @relation("UnitResourceImage", fields: [imageFileId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("UnitResourceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("unit_resources")
}

// ------------------------------------------------------------
// La Bitácora de la unidad
// ------------------------------------------------------------

model LogbookEntry {
  id              String             @id @default(uuid()) @db.Uuid
  title           String             @db.VarChar(160)
  adventureDate   DateTime           @default(now()) @map("adventure_date") @db.Date
  contentMd       String             @map("content_md") @db.Text
  status          LogbookEntryStatus @default(PENDIENTE_APROBACION)
  pageNumber      Int?               @unique @map("page_number")
  authorId        String             @map("author_id") @db.Uuid
  activityId      String?            @map("activity_id") @db.Uuid
  photoFileId     String?            @map("photo_file_id") @db.Uuid
  reviewedById    String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason String?            @map("rejection_reason") @db.Text
  publishedAt     DateTime?          @map("published_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(3)

  author     User      @relation("LogbookEntryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  photoFile  File?     @relation("LogbookEntryPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  reviewedBy User?     @relation("LogbookEntryReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, pageNumber])
  @@index([adventureDate])
  @@index([authorId])
  @@index([activityId])
  @@map("logbook_entries")
}

// ------------------------------------------------------------
// La Brújula: objetivos personales y acompañamiento 1 a 1
// ------------------------------------------------------------

/**
 * Catálogo referencial de objetivos intermedios (15–17 años) y terminales.
 * Se siembra desde `src/data/instrumento-objetivos.json` y está disponible
 * completo desde el ingreso: no se bloquea por edad, antigüedad ni etapa.
 */
model CompassObjectiveTemplate {
  id                    String          @id @default(uuid()) @db.Uuid
  code                  String          @unique @db.VarChar(40)
  area                  DevelopmentArea
  terminalObjective     String          @db.Text
  intermediateObjective String          @db.Text
  sortOrder             Int             @default(0) @map("sort_order")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  adoptions UserCompassObjective[]

  @@index([area, sortOrder])
  @@map("compass_objective_templates")
}

/**
 * Objetivo que el joven adopta o crea en su propia Brújula.
 * Solo el titular escribe; el AA encargado únicamente lee.
 */
model UserCompassObjective {
  id                   String                 @id @default(uuid()) @db.Uuid
  userId               String                 @map("user_id") @db.Uuid
  area                 DevelopmentArea
  templateId           String?                @map("template_id") @db.Uuid
  terminalObjectiveRef String?                @map("terminal_objective_ref") @db.Text
  currentText          String                 @map("current_text") @db.Text
  status               CompassObjectiveStatus @default(EXPLORANDO)
  sharedWithCommunity  Boolean                @default(false) @map("shared_with_community")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User                          @relation("UserCompassObjectiveUser", fields: [userId], references: [id], onDelete: Cascade)
  template  CompassObjectiveTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  versions  UserCompassObjectiveVersion[]
  reflections UserCompassReflection[]

  @@index([userId, area])
  @@index([templateId])
  @@map("user_compass_objectives")
}

/**
 * Historial inmutable de redacciones. Cada adopción, reformulación o creación
 * inserta una fila nueva; nunca se actualiza ni se borra una versión previa.
 */
model UserCompassObjectiveVersion {
  id          String   @id @default(uuid()) @db.Uuid
  objectiveId String   @map("objective_id") @db.Uuid
  text        String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  objective UserCompassObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([objectiveId, createdAt])
  @@map("user_compass_objective_versions")
}

/**
 * Reflexión personal o autoevaluación de ciclo. Puede nacer desde una
 * actividad y siempre pertenece al joven que la escribe.
 */
model UserCompassReflection {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  objectiveId           String?  @map("objective_id") @db.Uuid
  activityId            String?  @map("activity_id") @db.Uuid
  isCycleSelfEvaluation  Boolean  @default(false) @map("is_cycle_self_evaluation")
  cycleLabel            String?  @map("cycle_label") @db.VarChar(120)
  content               String   @db.Text
  sharedWithAa          Boolean  @default(true) @map("shared_with_aa")
  sharedWithCommunity   Boolean  @default(false) @map("shared_with_community")
  consensusNote         String?  @map("consensus_note") @db.Text
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User                   @relation("UserCompassReflectionUser", fields: [userId], references: [id], onDelete: Cascade)
  objective UserCompassObjective?  @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  activity  Activity?              @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([objectiveId])
  @@index([activityId])
  @@map("user_compass_reflections")
}

/**
 * Nota privada del AA encargado sobre el joven. Se comparte solo si el propio
 * AA activa `sharedWithStudent`. El historial sigue al `assignedAaId` vigente.
 */
model MentoringNote {
  id               String   @id @default(uuid()) @db.Uuid
  studentId        String   @map("student_id") @db.Uuid
  authorAaId       String?  @map("author_aa_id") @db.Uuid
  content          String   @db.Text
  sharedWithStudent Boolean @default(false) @map("shared_with_student")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  student User  @relation("MentoringNoteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  author  User? @relation("MentoringNoteAuthor", fields: [authorAaId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([authorAaId])
  @@map("mentoring_notes")
}

// ------------------------------------------------------------
// Bitácora privada de comunidad
// ------------------------------------------------------------

model CommunityLogEntry {
  id                    String   @id @default(uuid()) @db.Uuid
  communityId           String   @map("community_id") @db.Uuid
  authorId              String?  @map("author_id") @db.Uuid
  authorNameSnapshot    String   @map("author_name_snapshot") @db.VarChar(160)
  title                 String   @db.VarChar(160)
  content               String   @db.Text
  sharedWithAa          Boolean  @default(false) @map("shared_with_aa")
  sharedWithCoordinators Boolean @default(false) @map("shared_with_coordinators")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User?     @relation("CommunityLogEntryAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([communityId, createdAt])
  @@index([authorId])
  @@map("community_log_entries")
}

// ------------------------------------------------------------
// Auditoría
// ------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  Role?    @map("actor_role")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(300)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
  @@map("audit_logs")
}
