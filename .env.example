# ============================================================
# Avanzada Lankuyen — variables de entorno
# Copia este archivo como `.env` y ajusta los valores.
# ============================================================

# --- Base de datos -------------------------------------------------
# Desarrollo local con `docker compose up -d` (PostgreSQL en el puerto 5433
# para no chocar con una instalación local de PostgreSQL en el 5432).
DATABASE_URL="postgresql://lankuyen:lankuyen_dev@localhost:5433/lankuyen?schema=public"

# En Neon/Supabase: URL directa (sin pooler) para migraciones.
# En local puede quedar igual que DATABASE_URL.
DIRECT_URL="postgresql://lankuyen:lankuyen_dev@localhost:5433/lankuyen?schema=public"

# --- Autenticación -------------------------------------------------
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="cambia-este-secreto-en-produccion"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Aplicación ----------------------------------------------------
APP_TIMEZONE="America/Santiago"
APP_NAME="Avanzada Lankuyen"

# --- Almacenamiento de archivos -----------------------------------
# local  -> disco local (desarrollo, sin servicios externos)
# r2     -> Cloudflare R2 / S3 compatible (producción)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR=".storage"

# Solo si STORAGE_DRIVER="r2"
# El endpoint se deriva de R2_ACCOUNT_ID; usa R2_ENDPOINT para MinIO u otro S3.
R2_ACCOUNT_ID=""
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_REGION="auto"
R2_FORCE_PATH_STYLE="false"

# --- Cronjob -------------------------------------------------------
# Cabecera Authorization: Bearer <CRON_SECRET> en el endpoint de cron.
CRON_SECRET="cambia-este-secreto-de-cron"

# --- Seed: Adulto Acompañante inicial ------------------------------
# Se crea una sola vez con `npm run db:seed`. Debe cambiar la contraseña
# en el primer inicio de sesión.
SEED_AA_USERNAME="aa.lankuyen"
SEED_AA_PASSWORD="Lankuyen2026!"
SEED_AA_EMAIL="aa@lankuyen.cl"
SEED_AA_FIRST_NAME="Adulto"
SEED_AA_LAST_NAME="Acompañante"
